# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=          # from @BotFather
ALLOWED_USER_ID=         # from @userinfobot (your numeric Telegram ID)
GROQ_API_KEY=            # from console.groq.com (free, no card)
GEMINI_API_KEY=          # from aistudio.google.com/apikey (free)
AWS_REGION=ap-south-1   # Mumbai — best for India latency

# ── Optional: Gmail + Calendar (Step 5 in README) ────────────────────────────
# Run scripts/setup_google_auth.py once to generate this
GMAIL_TOKEN_JSON=

# ── Optional: Instagram auto-posting ─────────────────────────────────────────
# Requires Facebook Business Manager + Instagram Professional accounts
INSTAGRAM_ACCESS_TOKEN=
LAUNCHLAYER_IG_ACCOUNT_ID=         # IG Business Account ID for @launchlayer
LAUNCHLAYER_FINANCE_IG_ACCOUNT_ID= # IG Business Account ID for @launchlayerfinance
